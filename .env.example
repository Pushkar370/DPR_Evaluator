# =====================================================================
# DPR Quality & Compliance Assessment System - Environment Configuration
# =====================================================================

# 1. Gemini API Keys (Up to 3 keys for pool rotation & rate-limit fallback)
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_MODEL_NAME=gemini-3.5-flash-lite

# 2. Groq Cloud API Keys (Up to 2 keys for cross-provider fallback; must start with gsk_)
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# 3. Persistent SQLite Database
SQLITE_DB_PATH=dpr_evaluation.db

# 4. Local Vector Store & Embeddings
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
QDRANT_LOCAL_PATH=local_qdrant_data
QDRANT_COLLECTION_NAME=dpr_documents
GUIDELINES_COLLECTION_NAME=dpr_guidelines

# 5. File Directories
GUIDELINES_DIR=guidelines
UPLOADS_DIR=uploads

# 6. Multi-Agent Pillar Weights (Must sum to 1.0)
WEIGHT_TECHNICAL=0.30
WEIGHT_FINANCIAL=0.30
WEIGHT_ADMINISTRATIVE=0.20
WEIGHT_SOCIAL=0.20
